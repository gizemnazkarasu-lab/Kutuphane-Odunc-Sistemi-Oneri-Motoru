{
    "name": "Kutuphane Odunc Sistemi",
    "image": "mcr.microsoft.com/devcontainers/php:8.3",
    "postStartCommand": "nohup php -S 0.0.0.0:8080 -t public > /tmp/php-server.log 2>&1 &",
    "forwardPorts": [8080],
    "portsAttributes": {
        "8080": {
            "label": "Kutuphane Web Uygulamasi",
            "onAutoForward": "openBrowser"
        }
    }
}
